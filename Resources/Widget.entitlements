<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Widgets must be sandboxed. The network is for the ground elevation and the large widget's map. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- A fresh location, when you've allowed Bearings to use it. -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <!-- Shared with the app: its last fix, place and settings. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>2XV97FZ86G.com.bradcowdrey.bearings</string>
    </array>
</dict>
</plist>
