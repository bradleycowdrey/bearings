# App Store listing for the iPhone and iPad app, run by .github/workflows/app-store.yml with an
# App Store Connect API key (api_key.json, written by the workflow from GitHub secrets).
# It uploads the listing text and screenshots and sets content rights, age rating (4+), price (Free)
# and availability. It never uploads a build or submits for review.
require "net/http"
require "json"

default_platform(:ios)

API_KEY = "fastlane/api_key.json"
BUNDLE_ID = "com.bradcowdrey.bearings"

platform :ios do
  lane :listing do |options|
    prepare_app_store
    ensure_review_detail
    upload_to_app_store(
      api_key_path: API_KEY,
      app_identifier: BUNDLE_ID,
      app_version: options[:version],
      skip_binary_upload: true,
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true,
      force: true,                        # no HTML preview to confirm on CI
      run_precheck_before_submit: false,  # precheck can't run with an API key
      submit_for_review: false,
      ignore_language_directory_validation: true
    )
    attach_build(options)
  end

  # Public TestFlight beta, so anyone can install the iPhone app before it's on the App Store: makes
  # sure there's an external group "Public" with a public link, the beta's description and contact,
  # adds the newest processed build of this version and submits it for Beta App Review (Apple reviews
  # the first build of a version; later builds usually go out without waiting). Prints the public link.
  lane :public_beta do |options|
    login
    _, apps = asc(:get, "v1/apps?filter[bundleId]=#{BUNDLE_ID}")
    app = apps.dig("data", 0, "id")
    UI.user_error!("No app with bundle ID #{BUNDLE_ID} in App Store Connect") unless app
    root = File.basename(Dir.pwd) == "fastlane" ? File.dirname(Dir.pwd) : Dir.pwd
    read = ->(name) { path = File.join(root, "fastlane/metadata/#{name}.txt"); File.exist?(path) ? File.read(path).strip : nil }
    email = read.call("review_information/email_address")

    # What testers see in TestFlight, and where their feedback goes.
    description = "Bearings: the compass, where you are, your coordinates and elevation, the sun and moon, and a map, on one screen. Free, no ads, no account."
    _, locs = asc(:get, "v1/apps/#{app}/betaAppLocalizations")
    loc = (locs["data"] || []).find { |l| l.dig("attributes", "locale") == "en-US" }
    attrs = { description: description, feedbackEmail: email, privacyPolicyUrl: read.call("en-US/privacy_url"), marketingUrl: read.call("en-US/marketing_url") }.compact
    if loc
      code, body = asc(:patch, "v1/betaAppLocalizations/#{loc["id"]}", { data: { type: "betaAppLocalizations", id: loc["id"], attributes: attrs } })
    else
      code, body = asc(:post, "v1/betaAppLocalizations", { data: { type: "betaAppLocalizations", attributes: attrs.merge(locale: "en-US"),
        relationships: { app: { data: { type: "apps", id: app } } } } })
    end
    report("Beta description", code, body)

    # Contact for Beta App Review (same as the App Store review contact). Its id is the app's id.
    code, body = asc(:patch, "v1/betaAppReviewDetails/#{app}", { data: { type: "betaAppReviewDetails", id: app, attributes: {
      contactFirstName: read.call("review_information/first_name"), contactLastName: read.call("review_information/last_name"),
      contactEmail: email, contactPhone: read.call("review_information/phone_number"),
      demoAccountRequired: false, notes: read.call("review_information/notes") }.compact } })
    report("Beta review contact", code, body)

    # The external group with a public link (up to 10,000 testers).
    _, groups = asc(:get, "v1/betaGroups?filter[app]=#{app}&limit=200")
    group = (groups["data"] || []).find { |g| g.dig("attributes", "name") == "Public" }
    unless group
      code, body = asc(:post, "v1/betaGroups", { data: { type: "betaGroups", attributes: { name: "Public",
        publicLinkEnabled: true, publicLinkLimitEnabled: false, feedbackEnabled: true },
        relationships: { app: { data: { type: "apps", id: app } } } } })
      report("Public group", code, body)
      group = body["data"]
    end
    UI.user_error!("Couldn't create the Public group") unless group
    unless group.dig("attributes", "publicLinkEnabled")
      code, body = asc(:patch, "v1/betaGroups/#{group["id"]}", { data: { type: "betaGroups", id: group["id"],
        attributes: { publicLinkEnabled: true, publicLinkLimitEnabled: false } } })
      report("Public link", code, body)
      group = body["data"] || group
    end

    # The newest build of this version, once Apple has processed it (waits up to 40 minutes).
    build = nil
    16.times do |i|
      _, builds = asc(:get, "v1/builds?filter[app]=#{app}&filter[preReleaseVersion.version]=#{options[:version]}&sort=-uploadedDate&limit=1")
      b = builds.dig("data", 0)
      state = b && b.dig("attributes", "processingState")
      if state == "VALID" then build = b; break end
      UI.message("Build of #{options[:version]}: #{state || "not uploaded yet"}; checking again in 2.5 minutes (#{i + 1}/16)")
      sleep(150)
    end
    UI.user_error!("No processed build of #{options[:version]} yet; upload one with the iPhone TestFlight workflow, then run this again") unless build
    number = build.dig("attributes", "version")

    # What to test, shown to testers for this build.
    notes = "Bearings #{options[:version]}. Try the compass outdoors away from metal, the coordinate formats (tap the position tile), marking a spot and the widgets. Send feedback with a screenshot from TestFlight."
    _, bl = asc(:get, "v1/builds/#{build["id"]}/betaBuildLocalizations")
    existing = (bl["data"] || []).find { |l| l.dig("attributes", "locale") == "en-US" }
    if existing
      code, body = asc(:patch, "v1/betaBuildLocalizations/#{existing["id"]}", { data: { type: "betaBuildLocalizations", id: existing["id"], attributes: { whatsNew: notes } } })
    else
      code, body = asc(:post, "v1/betaBuildLocalizations", { data: { type: "betaBuildLocalizations", attributes: { locale: "en-US", whatsNew: notes },
        relationships: { build: { data: { type: "builds", id: build["id"] } } } } })
    end
    report("What to test (build #{number})", code, body)

    code, body = asc(:post, "v1/betaGroups/#{group["id"]}/relationships/builds", { data: [{ type: "builds", id: build["id"] }] })
    report("Build #{number} added to Public", code, body)

    code, body = asc(:post, "v1/betaAppReviewSubmissions", { data: { type: "betaAppReviewSubmissions",
      relationships: { build: { data: { type: "builds", id: build["id"] } } } } })
    if code == 409
      UI.message("Build #{number} is already submitted or approved for external testing")
    else
      report("Build #{number} submitted for Beta App Review", code, body)
    end
    _, detail = asc(:get, "v1/builds/#{build["id"]}/buildBetaDetail")
    UI.message("External testing state: #{detail.dig("data", "attributes", "externalBuildState")}")

    link = group.dig("attributes", "publicLink")
    UI.success("Public TestFlight link: #{link}")
    File.write(File.join(root, "testflight-link.txt"), "#{link}\n") if link
  end

  # Signs in to App Store Connect with the API key the workflow wrote to fastlane/api_key.json.
  private_lane :login do
    root = File.basename(Dir.pwd) == "fastlane" ? File.dirname(Dir.pwd) : Dir.pwd
    key = JSON.parse(File.read(File.join(root, API_KEY)))
    app_store_connect_api_key(key_id: key["key_id"], issuer_id: key["issuer_id"], key_content: key["key"])
  end

  # Picks the newest processed build of this version for the App Store version, which is also what
  # makes App Store Connect show the app's icon. Choosing a build doesn't submit anything.
  private_lane :attach_build do |options|
    _, apps = asc(:get, "v1/apps?filter[bundleId]=#{BUNDLE_ID}")
    app = apps.dig("data", 0, "id")
    _, versions = asc(:get, "v1/apps/#{app}/appStoreVersions?filter[platform]=IOS&filter[versionString]=#{options[:version]}")
    version = versions.dig("data", 0, "id")
    _, builds = asc(:get, "v1/builds?filter[app]=#{app}&filter[preReleaseVersion.version]=#{options[:version]}&filter[processingState]=VALID&sort=-uploadedDate&limit=1")
    build = builds.dig("data", 0)
    if version && build
      code, body = asc(:patch, "v1/appStoreVersions/#{version}/relationships/build", { data: { type: "builds", id: build["id"] } })
      report("Build #{build.dig("attributes", "version")} attached to #{options[:version]}", code, body)
    else
      UI.important("No App Store version or processed build to attach yet")
    end
  end

  def asc(method, path, body = nil)
    uri = URI("https://api.appstoreconnect.apple.com/#{path}")
    request = Net::HTTP.const_get(method.to_s.capitalize).new(uri)
    request["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
    request["Content-Type"] = "application/json"
    request.body = body.to_json if body
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
    [response.code.to_i, (JSON.parse(response.body) rescue {})]
  end

  def report(label, code, body)
    if code.between?(200, 299)
      UI.success("#{label}: done")
    else
      UI.important("#{label}: #{code} #{(body["errors"] || []).map { |e| e["detail"] || e["title"] }.join("; ")}")
    end
  end

  # Settings the listing upload doesn't cover. Each is reported, and skipped if Apple refuses it
  # because it's already set.
  private_lane :prepare_app_store do
    root = File.basename(Dir.pwd) == "fastlane" ? File.dirname(Dir.pwd) : Dir.pwd
    key = JSON.parse(File.read(File.join(root, API_KEY)))
    app_store_connect_api_key(key_id: key["key_id"], issuer_id: key["issuer_id"], key_content: key["key"])
    _, apps = asc(:get, "v1/apps?filter[bundleId]=#{BUNDLE_ID}")
    app = apps.dig("data", 0, "id")
    UI.user_error!("No app with bundle ID #{BUNDLE_ID} in App Store Connect") unless app

    # The built-in list of towns comes from GeoNames (CC BY 4.0), so the app shows third-party content
    # it has the rights to use.
    code, body = asc(:patch, "v1/apps/#{app}", { data: { type: "apps", id: app,
      attributes: { contentRightsDeclaration: "USES_THIRD_PARTY_CONTENT" } } })
    report("Content rights", code, body)

    _, infos = asc(:get, "v1/apps/#{app}/appInfos")
    info = (infos["data"] || []).find { |i| i.dig("attributes", "appStoreState") != "READY_FOR_SALE" } || (infos["data"] || []).first
    if info
      _, declaration = asc(:get, "v1/appInfos/#{info["id"]}/ageRatingDeclaration")
      id = declaration.dig("data", "id")
      present = (declaration.dig("data", "attributes") || {}).keys
      none = %w[alcoholTobaccoOrDrugUseOrReferences contests gamblingSimulated horrorOrFearThemes
                matureOrSuggestiveThemes medicalOrTreatmentInformation profanityOrCrudeHumor
                sexualContentGraphicAndNudity sexualContentOrNudity violenceCartoonOrFantasy
                violenceRealistic violenceRealisticProlongedGraphicOrSadistic gunsOrOtherWeapons]
      no = %w[gambling unrestrictedWebAccess lootBox messagingAndChat parentalControls ageAssurance
              userGeneratedContent healthOrWellnessTopics advertising socialMedia]
      attributes = none.to_h { |k| [k, "NONE"] }.merge(no.to_h { |k| [k, false] })
      attributes.select! { |k, _| present.include?(k) } unless present.empty?
      code, body = asc(:patch, "v1/ageRatingDeclarations/#{id}", { data: { type: "ageRatingDeclarations", id: id, attributes: attributes } })
      report("Age rating (4+)", code, body)
    end

    _, points = asc(:get, "v1/apps/#{app}/appPricePoints?filter[territory]=USA&limit=200")
    free = (points["data"] || []).find { |p| p.dig("attributes", "customerPrice").to_f.zero? }
    if free
      code, body = asc(:post, "v1/appPriceSchedules", {
        data: { type: "appPriceSchedules", relationships: {
          app: { data: { type: "apps", id: app } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "appPrices", id: "${free}" }] } } },
        included: [{ type: "appPrices", id: "${free}", attributes: { startDate: nil },
          relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } } }] })
      report("Price (Free)", code, body)
    end

    _, territories = asc(:get, "v1/territories?limit=200")
    ids = (territories["data"] || []).map { |t| t["id"] }
    code, body = asc(:post, "v2/appAvailabilities", {
      data: { type: "appAvailabilities", attributes: { availableInNewTerritories: true }, relationships: {
        app: { data: { type: "apps", id: app } },
        territoryAvailabilities: { data: ids.map { |t| { type: "territoryAvailabilities", id: "${#{t}}" } } } } },
      included: ids.map { |t| { type: "territoryAvailabilities", id: "${#{t}}", attributes: { available: true },
        relationships: { territory: { data: { type: "territories", id: t } } } } } })
    report("Availability (all countries)", code, body) unless code == 409   # 409: already set
  end

  # A new version has no App Review contact record yet, and the listing upload fails fetching it
  # ("No data"), so create one. Email and phone come from metadata/review_information (the same
  # contact as Meridian's), or the APP_REVIEW_EMAIL and APP_REVIEW_PHONE secrets if set.
  private_lane :ensure_review_detail do
    root = File.basename(Dir.pwd) == "fastlane" ? File.dirname(Dir.pwd) : Dir.pwd
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    next if version.nil?
    detail = begin
      version.fetch_app_store_review_detail
    rescue StandardError
      nil
    end
    if detail
      UI.message("App Review details already exist")
    else
      read = ->(name) { path = File.join(root, "fastlane/metadata/review_information/#{name}.txt"); File.exist?(path) ? File.read(path).strip : nil }
      blank = ->(v) { v.nil? || v.empty? ? nil : v }
      attributes = {
        contact_first_name: read.call("first_name"),
        contact_last_name: read.call("last_name"),
        contact_email: blank.call(ENV["APP_REVIEW_EMAIL"]) || read.call("email_address"),
        contact_phone: blank.call(ENV["APP_REVIEW_PHONE"]) || read.call("phone_number"),
        notes: read.call("notes"),
        demo_account_required: false
      }.compact
      version.create_app_store_review_detail(attributes: attributes)
      UI.success("Created App Review details")
    end
  end

end
